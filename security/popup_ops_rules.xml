<odoo>
    <!-- Global rules ensure other group rules cannot widen company access. -->
    <record id="rule_popup_ops_booking_company" model="ir.rule">
        <field name="name">PopUpOps bookings: allowed companies</field>
        <field name="model_id" ref="model_popup_ops_booking"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_popup_ops_line_company" model="ir.rule">
        <field name="name">PopUpOps booking lines: allowed companies</field>
        <field name="model_id" ref="model_popup_ops_booking_line"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('booking_id.company_id', 'in', company_ids)]</field>
    </record>
</odoo>
